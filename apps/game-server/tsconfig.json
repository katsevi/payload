{
  // Servidor de juego (Node >= 22). tsc solo comprueba tipos: el build lo hace esbuild (scripts/build.mjs)
  // y en desarrollo corre con tsx. @payload/shared se importa como fuente TS (se comprueba con estas opciones).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "scripts", "vitest.config.ts"]
}
