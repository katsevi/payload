{
  "name": "payload",
  "private": true,
  "version": "0.4.0",
  "description": "Payload — juego cooperativo 3D web de supervivencia y gestión de recursos espaciales (1-4 jugadores)",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@payload/client",
    "dev:server": "pnpm --filter @payload/game-server dev",
    "dev:lan": "pnpm --filter @payload/client dev:lan",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run typecheck test build",
    "balance": "pnpm --filter @payload/shared balance"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
